# Copy to .env and fill in. Never commit the real .env. It is git-ignored.
#
# Obtain the client ID and secret from Google Cloud Console:
#   APIs & Services -> Credentials -> Create Credentials -> OAuth client ID -> Desktop app
# Then run `npm run authorize` to mint the refresh token.
#
# See the README's Setup section for the full walkthrough.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional. Set to drive.file (for both `npm run authorize` and the server) to request the
# non-restricted per-file scope instead of full Drive access. See the README's Security section.
# GOOGLE_OAUTH_SCOPE=
